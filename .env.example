# Beispiel-Konfiguration für LexAudit DE/EU
# Kopiere diese Datei nach `.env` und ergänze nur benötigte Schlüssel.
# WICHTIG: `.env` niemals in Git committen!

# Betrieb ohne API-Key im deterministischen/Offline-Modus möglich:
LEXAUDIT_ENV=development
LEXAUDIT_OFFLINE_DEMO=false

# Datenbanken (Docker Compose Standardwerte für lokale Entwicklung)
DATABASE_URL=postgresql+psycopg://lexaudit:lexaudit_dev@127.0.0.1:5432/lexaudit
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=lexaudit_neo4j_dev

# Graph-Backend: "auto" (Neo4j wenn erreichbar, sonst InMemory/NetworkX), "neo4j", "age", "memory"
LEXAUDIT_GRAPH_BACKEND=auto

# Embedding-Adapter: "deterministic" (Zero-Dep Lokaltest), "qwen3-4b", "bge-m3", "ollama"
LEXAUDIT_EMBEDDING_PROVIDER=deterministic
LEXAUDIT_OLLAMA_BASE_URL=http://127.0.0.1:11434

# OpenRouter (OPTIONAL — nur erforderlich für Live-LLM-Stufen 3/4/5)
# Für :free-Kontingent (1.000 Req/Tag) mind. 10 USD Guthaben im OpenRouter-Dashboard hinterlegen.
OPENROUTER_API_KEY=
OPENROUTER_FREE_MODEL=deepseek/deepseek-v4-flash:free
OPENROUTER_MID_MODEL=deepseek/deepseek-v4-pro
OPENROUTER_FRONTIER_MODEL=anthropic/claude-sonnet-5.5

# Harte Budget- & Sicherheits-Guardrails
LEXAUDIT_MAX_DAILY_USD=5.00
LEXAUDIT_MAX_FREE_REQ_PER_DAY=950
LEXAUDIT_MAX_FREE_REQ_PER_MIN=18
LEXAUDIT_MAX_CITATION_ERROR_RATE=0.08

# Bundestag DIP API v1 (optional: öffentlicher Test-Key oder eigener Key via parlamentsdokumentation@bundestag.de)
BUNDESTAG_DIP_API_KEY=

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
